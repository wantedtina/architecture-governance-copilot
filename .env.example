# Local configuration template. Copy to .env; never commit your local .env.
# Load explicitly: uv run --env-file .env streamlit run app.py
# Restart the application after changing these values.

# demo, development, test, or production. Production currently has no live capabilities.
AGC_DEPLOYMENT_PROFILE=demo

# Enable only with development or test. All fake operations remain in memory and offline.
AGC_INTERNAL_FAKE_ENABLED=false

# Per-phase demo delay in seconds; use 0 for faster local testing.
AGC_DEMO_STEP_DELAY_SECONDS=0.4

# Optional fake provider identity. Leave commented to use the default.
# Changing this identity invalidates its bound review package.
# AGC_INTERNAL_FAKE_PROVIDER_ID=internal-fake-aif-v3

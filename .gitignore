# Preserve already-versioned historical media when relocating
!/video/archive/pre-v1/output/architecture_governance_copilot_human_voice.mp4
!/video/archive/pre-v1/output/architecture_governance_copilot_human_voice.srt

# Generated render instructions and disposable chapter narration
/video/v1/**/*-command.json
/video/v2/**/*-command.json
/video/v1/**/*.filter
/video/v2/**/*.filter
/video/v1/**/*.fffilter
/video/v2/**/*.fffilter
/video/v1/**/concat.txt
/video/v2/**/concat.txt
/video/v1/narration/working/*.txt
/video/v2/production/tool-assisted-v2/production/assets/voice/*.txt
/video/v2/production/tool-assisted-v2/production/audio/*.ass
!/video/v2/production/tool-assisted-v2/production/audio/title.ass
/video/v2/production/tool-assisted-v2-human-voice/audio/*.ass

# Local duplicate export snapshots and earlier submission drafts
/video/v2/production/history/submission-documents/
/video/v1/production/history/accepted-export-metadata/*.svg
/video/v1/production/history/accepted-export-metadata/*.srt
/video/v1/production/history/accepted-export-metadata/NARRATION_V2.2.md
/video/v1/production/history/accepted-export-metadata/FORM_TEXT.md
/video/v2/production/tool-assisted-v2/export/*.svg
/video/v2/production/tool-assisted-v2/export/*.srt
/video/v2/production/tool-assisted-v2/export/NARRATION_V2.md
/video/v2/production/tool-assisted-v2/export/FORM_TEXT.md
/video/v2/production/tool-assisted-v2-human-voice/export/*.srt
/video/v2/production/tool-assisted-v2-human-voice/export/NARRATION_HUMAN_VOICE.md
/video/v2/production/tool-assisted-v2/production/assets/slides/*.svg

# Keep only the required deck build sources inside the generic ignored build folder
!/video/v2/slides/build/
/video/v2/slides/build/*
!/video/v2/slides/build/build.mjs
!/video/v2/slides/build/finalize.mjs
!/video/v2/slides/build/slides.json

# Local original production workspaces and protected backups
/video/archive/production-originals/

  "sections": [
    {
      "id": "title",
      "title": "Architecture Governance Copilot",
      "start": 0,
      "end": 10,
      "duration": 10,
      "tempo": 1.0680851063829786,
      "speech": [
        {
          "index": 0,
          "text": "Hello, we're Two Tokens One Brain. Let me show you how Architecture Governance Copilot helps teams prepare and follow up on architecture reviews.",
          "start": 0.3,
          "end": 9.7,
          "source_duration": 10.04,
          "tempo": 1.0680851063829786,
          "measured_pause_candidates": [
            0.6536285,
            2.725805
          ]
        }
      ],
      "captions": [
        [
          0.3,
          2.9858049999999996,
          "Hello, we're Two Tokens One Brain."
        ],
        [
          3.0258049999999996,
          9.660000000000002,
          "Let me show you how Architecture Governance Copilot helps teams prepare and follow up on architecture reviews."
        ]
      ]
    },
    {
      "id": "process",
      "title": "The problem: fragmented governance work",
      "start": 10,
      "end": 28,
      "duration": 18,
      "tempo": 1.0331010452961673,
      "speech": [
        {
          "index": 0,
          "text": "Today, a project team writes its Solution Intent in Confluence, tracks the review in Azure Boards, and discusses the design in Teams.",
          "start": 0.3,
          "end": 9.1665,
          "source_duration": 9.16,
          "tempo": 1.0331010452961673,
          "measured_pause_candidates": [
            0.6730385000000001,
            4.4139005000000004,
            6.564036
          ]
        },
        {
          "index": 1,
          "text": "Afterwards, someone has to bring the decisions, evidence and action owners back together. That's the work we're trying to make easier.",
          "start": 9.4065,
          "end": 17.76,
          "source_duration": 8.63,
          "tempo": 1.0331010452961673,
          "measured_pause_candidates": [
            1.0749659999999999,
            3.4805895,
            5.947982
          ]
        }
      ],

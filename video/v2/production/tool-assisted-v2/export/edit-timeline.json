    {
      "id": "solution",
      "title": "Two activities, explicit human checkpoints",
      "start": 28,
      "end": 46,
      "duration": 18,
      "tempo": 1.0,
      "speech": [
        {
          "index": 0,
          "text": "Our app helps with drafting and review, but Confluence remains the source of truth for the Solution Intent.",
          "start": 0.3,
          "end": 6.86,
          "source_duration": 6.56,
          "tempo": 1.0,
          "measured_pause_candidates": [
            2.476145
          ]
        },
        {
          "index": 1,
          "text": "We only produce drafts and suggested changes. The app never edits Confluence. Users decide what to keep and make those changes themselves.",
          "start": 7.615,
          "end": 17.245,
          "source_duration": 9.63,
          "tempo": 1.0,
          "measured_pause_candidates": [
            3.3529475,
            5.59873
          ]
        }
      ],
      "captions": [
        [
          0.3,
          2.7361449999999996,

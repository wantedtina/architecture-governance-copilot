    {
      "id": "human",
      "title": "3. Exercise human judgment",
      "start": 115,
      "end": 148,
      "duration": 33,
      "tempo": 1.0,
      "speech": [
        {
          "index": 0,
          "text": "This is where I review what the app has proposed. The transcript says Riley will document the retry controls. I'm changing that action's owner to Taylor Kim.",
          "start": 0.3,
          "end": 10.35,
          "source_duration": 10.05,
          "tempo": 1.0,
          "measured_pause_candidates": [
            3.093492,
            7.1810884999999995
          ]
        },
        {
          "index": 1,
          "text": "Notice that Riley's original words stay visible, alongside my change.",
          "start": 11.4925,
          "end": 16.3325,
          "source_duration": 4.84,
          "tempo": 1.0,
          "measured_pause_candidates": [
            3.0456234999999996
          ]
        },
        {
          "index": 2,
          "text": "I'm also leaving the retention finding out of this record. That doesn't mean the issue is resolved or approved.",
          "start": 17.475,
          "end": 23.975,
          "source_duration": 6.5,
          "tempo": 1.0,
          "measured_pause_candidates": [
            3.4516324999999997

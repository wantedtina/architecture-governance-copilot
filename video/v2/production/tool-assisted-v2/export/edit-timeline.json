    {
      "id": "draft",
      "title": "1. Prepare and confirm an SI draft",
      "start": 69,
      "end": 96,
      "duration": 27,
      "tempo": 1.0,
      "speech": [
        {
          "index": 0,
          "text": "Let's start with the project team. I open the project context, which brings together the template, repository revision and governance details.",
          "start": 0.3,
          "end": 10.21,
          "source_duration": 9.91,
          "tempo": 1.0,
          "measured_pause_candidates": [
            2.2234695,
            4.582698,
            6.835737
          ]
        },
        {
          "index": 1,
          "text": "I save the supporting evidence, confirm the package, and generate a Solution Intent draft.",
          "start": 10.5233,
          "end": 17.0433,
          "source_duration": 6.52,
          "tempo": 1.0,
          "measured_pause_candidates": [
            2.1275285,
            3.7849885
          ]
        },
        {
          "index": 2,
          "text": "I review and confirm that draft here. I would then make any changes I want in Confluence myself. The governance review is a separate step.",
          "start": 17.3567,
          "end": 26.6867,
          "source_duration": 9.33,
          "tempo": 1.0,
          "measured_pause_candidates": [
            2.546508,

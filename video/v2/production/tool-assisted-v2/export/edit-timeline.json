        ]
      ]
    },
    {
      "id": "architecture",
      "title": "System architecture",
      "start": 46,
      "end": 69,
      "duration": 23,
      "tempo": 1.0195099818511797,
      "speech": [
        {
          "index": 0,
          "text": "Both project teams and Domain Architects use the app, with different permissions and responsibilities.",
          "start": 0.3,
          "end": 6.607,
          "source_duration": 6.43,
          "tempo": 1.0195099818511797,
          "measured_pause_candidates": [
            3.2943765
          ]
        },
        {
          "index": 1,
          "text": "The interface sits in Service Bench. SKE hosts the backend and database, with adapters for Confluence, AI Factory and Azure DevOps.",
          "start": 6.827,
          "end": 16.5179,
          "source_duration": 9.88,
          "tempo": 1.0195099818511797,
          "measured_pause_candidates": [
            2.4548075000000003,
            5.385419499999999,
            7.4314515
          ]
        },
        {
          "index": 2,
          "text": "Teams transcripts are imported manually. Logs, traces and metrics go to COP.",
          "start": 16.7379,
          "end": 22.78,
          "source_duration": 6.16,
          "tempo": 1.0195099818511797,
          "measured_pause_candidates": [
            2.6605670000000003,
            3.519297
          ]
        }
      ],
      "captions": [

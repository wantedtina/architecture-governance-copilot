    {
      "id": "inputs",
      "title": "2. Select and confirm review inputs",
      "start": 96,
      "end": 115,
      "duration": 19,
      "tempo": 1.0,
      "speech": [
        {
          "index": 0,
          "text": "For the review, I select the authoritative Solution Intent, import the meeting transcript, and load the review details.",
